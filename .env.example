# ===== LLM 提供方（单一切换点）=====
# cloud  = 云端 OpenAI 兼容协议（DeepSeek / SiliconFlow / 通义千问 等）
# local  = 本地 Ollama（Sprint 4，需先安装 Ollama 并拉取模型）
LLM_PROVIDER=cloud

# ----- 云端配置（LLM_PROVIDER=cloud 时生效）-----
# 例：DeepSeek 官方
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# SiliconFlow（硅基流动，OpenAI 兼容，模型推荐）：
#   deepseek-ai/DeepSeek-V3          ← 推荐，与 DeepSeek 官方同族
#   Qwen/Qwen2.5-7B-Instruct
#   Qwen/Qwen2.5-72B-Instruct
#  ⚠️ 避免推理/思考类模型（如 Qwen3.X-4B 等），与 tool-calling agent 不兼容。
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# 模型额外参数（JSON 字符串），传给 provider 的 extra_body；
# 例：关闭 SiliconFlow Qwen3 思考模式 → {"enable_thinking": false}
LLM_EXTRA_BODY={}

# ----- 本地配置（LLM_PROVIDER=local 时生效）-----
OLLAMA_BASE_URL=http://localhost:11434/v1
# 需先：ollama pull qwen2.5:7b-instruct-q4_K_M
LLM_MODEL_LOCAL=qwen2.5:7b-instruct-q4_K_M

# ===== ASR（Sprint 2 起生效）=====
# faster-whisper 模型：tiny / base / small / medium（8GB 显存建议 base 或 small）
WHISPER_MODEL=base
# 设备：auto / cuda / cpu（本地显存吃紧时可强制 cpu）
ASR_DEVICE=auto

# ===== 运行期 =====
# 工作区目录（视频/音频缓存，>7 天自动清理）
WORKSPACE_DIR=workspace
