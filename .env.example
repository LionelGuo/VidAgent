# ===== LLM 提供方（provider 预设系统，详见 src/vidagent/llm_provider.py）=====
# vllm        = 自托管 vLLM-omni（bare mode，<tool_call> XML 协议）—— 场景一：本地有 ≥24GB GPU
# siliconflow = SiliconFlow 平台（原生 function calling，audio_url wire format）—— 场景二：远程 API
# generic     = 任意标准 OpenAI 兼容端点（原生透传，保守按 vllm-omni 格式）
# cloud       ≡ vllm（兼容旧值）
LLM_PROVIDER=siliconflow

# ── 场景二（推荐起步）：SiliconFlow 远程 API ──
# 仅需 provider + key；preset 自动提供 base_url（https://api.siliconflow.cn/v1）与模型名。
# -Thinking 变体恒思考、无需 enable_thinking 参数。SiliconFlow 仅支持 tool_choice=auto（已内置规范化）。
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 显式覆盖 preset 默认（通常留空即可）：
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen3-Omni-30B-A3B-Thinking

# ── 场景一：自托管 vLLM-omni（本地 ≥24GB GPU，部署见 scripts/deploy_vllm_omni.sh）──
# LLM_PROVIDER=vllm
# OPENAI_BASE_URL=http://127.0.0.1:6006/v1
# OPENAI_API_KEY=not-needed
# LLM_MODEL=Qwen/Qwen3-Omni-30B-A3B-Thinking
#
# 云 GPU 租用机（如 AutoDL）远程访问时，把 base_url 指向实例的「自定义服务」端口：
#   LLM_MODEL=/root/autodl-tmp/Qwen3-Omni-Thinking-AWQ-4bit   # 以 vLLM 实际加载的模型目录为准（/v1/models 可查）
#   OPENAI_BASE_URL=https://<实例ID>.westd.seetacloud.com:<端口>/v1
# 注意：AutoDL 自定义服务端口是 HTTPS（nginx TLS 终结）——写成 http:// 会报
# 400 "The plain HTTP request was sent to HTTPS port"。

# 多模态端点（与 Agent 模型分离时可填；留空则复用上面的 base_url + model，单端点平台直接留空）
# MULTIMODAL_BASE_URL=
# MULTIMODAL_MODEL=

# ===== 平台 Cookie / API Key =====
# B站 Cookie（创作者主页接口需要，含 SESSDATA）
# 形如 "SESSDATA=xxx; bili_jct=xxx; buvid3=xxx"，从浏览器复制
# BILI_COOKIE=

# YouTube API Key（可选，从 https://console.cloud.google.com/apis/credentials 创建）
# 免费配额 10000 units/day；无 key 时搜索降级为 yt-dlp ytsearch
# YOUTUBE_API_KEY=

# YouTube Cookie 文件（Netscape 格式，可选）
# 导出：浏览器安装 "Get cookies.txt LOCALLY" 插件 → 访问 youtube.com → 导出
# YOUTUBE_COOKIE=

# 代理（科学上网地址，用于 yt-dlp 下载 + YouTube API 请求）
# 注意：抖音/小红书/快手等 CDP 平台的部分请求也复用此代理配置
# YOUTUBE_PROXY=http://127.0.0.1:7890

# ===== 运行期 =====
# 工作区目录（视频/音频缓存，>7 天自动清理）
WORKSPACE_DIR=workspace

# MediaCrawler 目录（抖音/小红书/快手 CDP 平台需要）
# 默认指向仓库内 vendored 副本 vendor/MediaCrawler/（见 ADR-0007），通常无需设置；
# 仅当你要用外部/自定义 MediaCrawler 副本时覆盖：
# MEDIACRAWLER_ROOT=/path/to/MediaCrawler

# CDP 主机地址（抖音/小红书/快手连接 Chrome 调试端口的宿主，默认 localhost）
# 裸机 / WSL2 无需设置；Docker 桥接网络（尤其 Windows Docker Desktop）需设为：
# CDP_HOST=host.docker.internal
