# ===== LLM 提供方（单一切换点）=====
# cloud  = 云端 OpenAI 兼容协议（DeepSeek / 通义千问 等）
# local  = 本地 Ollama（Sprint 4，需先安装 Ollama 并拉取模型）
LLM_PROVIDER=cloud

# ----- 云端配置（LLM_PROVIDER=cloud 时生效）-----
# 例：DeepSeek
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# ----- 本地配置（LLM_PROVIDER=local 时生效）-----
OLLAMA_BASE_URL=http://localhost:11434/v1
# 需先：ollama pull qwen2.5:7b-instruct-q4_K_M
LLM_MODEL_LOCAL=qwen2.5:7b-instruct-q4_K_M

# ===== ASR（Sprint 2 起生效）=====
# faster-whisper 模型：tiny / base / small / medium（8GB 显存建议 base 或 small）
WHISPER_MODEL=base
# 设备：auto / cuda / cpu（本地显存吃紧时可强制 cpu）
ASR_DEVICE=auto

# ===== 运行期 =====
# 工作区目录（视频/音频缓存，>7 天自动清理）
WORKSPACE_DIR=workspace
