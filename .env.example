# ===== 模型服务（LLM_PROVIDER 决定其余三项的含义）=====
# 自托管 vllm 时需显式设置 LLM_BASE_URL 与 LLM_MODEL
LLM_PROVIDER=siliconflow        # vllm=自托管 / siliconflow=SiliconFlow / generic=任意 OpenAI 兼容端点
LLM_API_KEY=sk-xxx              # 模型服务密钥（vllm 自托管可随意填）
# LLM_BASE_URL=                 # 留空用 provider 预设端点
# LLM_MODEL=                    # 留空用 provider 预设模型

# ===== 平台访问 =====
# BILI_COOKIE=                  # B站 Cookie（创作者主页需要，含 SESSDATA）
# YOUTUBE_API_KEY=              # YouTube Data API v3 key（无 key 时搜索降级 yt-dlp）
# YOUTUBE_COOKIE=               # YouTube Cookie（Netscape 格式文件路径）
# YOUTUBE_PROXY=                # 网络代理（yt-dlp 与 CDP 平台部分请求复用）
# CDP_HOST=                     # 抖音/小红书/快手 Chrome 调试端口宿主（仅 Windows Docker 需设）

# ===== 运行期 =====
# WORKSPACE_DIR=workspace       # 视频/音频缓存目录
