# ===== LLM 提供方（单一切换点）=====
# cloud  = 云端 OpenAI 兼容协议（DeepSeek / SiliconFlow / 通义千问 等）
# local  = 本地 Ollama（Sprint 4，需先安装 Ollama 并拉取模型）
LLM_PROVIDER=cloud

# ----- 云端配置（LLM_PROVIDER=cloud 时生效）-----
# 例：DeepSeek 官方
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# SiliconFlow（硅基流动，OpenAI 兼容，模型推荐）：
#   deepseek-ai/DeepSeek-V3          ← 推荐，与 DeepSeek 官方同族
#   Qwen/Qwen2.5-7B-Instruct
#   Qwen/Qwen2.5-72B-Instruct
#  ⚠️ 避免纯推理/思考类模型（Qwen3.5-4B 等），与 tool-calling 不完全兼容。
#  Qwen3-Omni 系列**可用**（工具调用正常），但输出走 reasoning_content 流，
#  回答可能包含推理过程文本（不影响功能，略冗长）。
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# 模型额外参数（JSON 字符串），传给 provider 的 extra_body；
# 例：关闭 SiliconFlow Qwen3 思考模式 → {"enable_thinking": false}
LLM_EXTRA_BODY={}

# 多模态模型开关：设为 true 后 extract_and_summarize 跳过 ASR，音频直送 LLM
# 需要模型支持 audio_url（如 Qwen2.5-Omni-7B）
LLM_MULTIMODAL=false

# 多模态推理服务独立端点（与 Agent 模型分离：Agent 需 function calling，多模态不需）
# 留空则复用 OPENAI_BASE_URL + LLM_MODEL
# MULTIMODAL_BASE_URL=https://your-server.com:8443/v1
# MULTIMODAL_MODEL=Qwen/Qwen2.5-Omni-7B

# ----- 本地配置（LLM_PROVIDER=local 时生效）-----
OLLAMA_BASE_URL=http://localhost:11434/v1
# 需先：ollama pull qwen2.5:7b-instruct-q4_K_M
LLM_MODEL_LOCAL=qwen2.5:7b-instruct-q4_K_M

# ===== ASR（Sprint 2 起生效）=====
# faster-whisper 模型：tiny / base / small / medium（8GB 显存建议 base 或 small）
WHISPER_MODEL=base
# 设备：auto / cuda / cpu（本地显存吃紧时可强制 cpu）
ASR_DEVICE=auto

# ===== 平台 Cookie / API Key =====
# B站 Cookie（创作者主页接口需要，含 SESSDATA）
# 形如 "SESSDATA=xxx; bili_jct=xxx; buvid3=xxx"，从浏览器复制
# BILI_COOKIE=

# YouTube API Key（可选，从 https://console.cloud.google.com/apis/credentials 创建）
# 免费配额 10000 units/day；无 key 时搜索降级为 yt-dlp ytsearch
# YOUTUBE_API_KEY=

# YouTube Cookie 文件（Netscape 格式，可选）
# 导出：浏览器安装 "Get cookies.txt LOCALLY" 插件 → 访问 youtube.com → 导出
# YOUTUBE_COOKIE=

# YouTube 代理（科学上网地址，用于 yt-dlp 下载 + API 请求）
# YOUTUBE_PROXY=http://127.0.0.1:7890

# ===== 运行期 =====
# 工作区目录（视频/音频缓存，>7 天自动清理）
WORKSPACE_DIR=workspace
